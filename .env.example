# پورت اجرای سرور
PORT=3000

# کلید API آنتروپیک (Claude) - برای تحلیل رقبا و پیشنهاد متادیتا
ANTHROPIC_API_KEY=

# مدل کلود برای استفاده در تحلیل‌ها
ANTHROPIC_MODEL=claude-sonnet-5

# مسیر فایل JSON سرویس‌اکانت گوگل (برای Search Console API)
# راهنمای ساخت این فایل در README.md بخش «راه‌اندازی Google Search Console»
GSC_SERVICE_ACCOUNT_PATH=./data/gsc-service-account.json

# آدرس دقیق سایت همان‌طور که در Search Console ثبت شده
# مثال: https://capis.be/  یا  sc-domain:capis.be
GSC_SITE_URL=
